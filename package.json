{
  "name": "nathan-kim",
  "version": "1.0.0",
  "private": true,
  "description": "personal website for nathan kim",
  "author": "Nathan Kim",
  "type": "module",
  "scripts": {
    "run-ts": "node --loader ts-node/esm --experimental-specifier-resolution=node",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "node --experimental-specifier-resolution=node build/index.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --plugin-search-dir=. . && eslint .",
    "format": "prettier --write --plugin-search-dir=. .",
    "cv": "pnpm run-ts hooks/CV/process.ts"
  },
  "devDependencies": {
    "@citation-js/plugin-bibtex": "^0.6.1",
    "@eslint/js": "^9.17.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/enhanced-img": "^0.4.4",
    "@sveltejs/kit": "^2.5.27",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^2.0.1",
    "@types/express": "^4.17.13",
    "@types/marked": "^4.0.3",
    "@types/node": "^22.10.2",
    "@types/sharp": "^0.29.5",
    "dotenv": "^16.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^8.3.0",
    "express": "^4.18.1",
    "marked": "^4.0.18",
    "mdsvex": "^0.12.3",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-external-links": "^1.0.1",
    "rehype-slug": "^5.0.1",
    "sharp": "^0.29.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "ts-node": "^10.4.0",
    "tslib": "^2.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.4",
    "yaml": "^2.1.1"
  },
  "dependencies": {
    "@citation-js/core": "^0.6.1",
    "@citation-js/plugin-csl": "^0.6.4",
    "eslint-plugin-svelte": "^2.46.1",
    "jspdf": "^2.5.1"
  }
