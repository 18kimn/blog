{
  "name": "nathan-kim",
  "version": "1.0.0",
  "private": true,
  "description": "personal website for nathan kim",
  "author": "Nathan Kim",
  "type": "module",
  "scripts": {
    "run-ts": "node --loader ts-node/esm --experimental-specifier-resolution=node",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "node --experimental-specifier-resolution=node build/index.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --write . && eslint . --fix",
    "format": "prettier --write --plugin-search-dir=. .",
    "cv": "pnpm run-ts src/hooks/CV/process.ts",
    "subscribers": "pnpm run-ts src/hooks/subscribers.ts",
    "build:error": "ERROR_PAGE_BUILD=true vite build && cp error-build/cloudflare-error.html worker/cloudflare-error.html",
    "deploy:worker": "pnpm run build:error && wrangler deploy"
  },
  "devDependencies": {
    "@citation-js/plugin-bibtex": "^0.6.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.17.0",
    "@sveltejs/adapter-node": "^2.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.4.4",
    "@sveltejs/kit": "^2.5.27",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^2.0.1",
    "@types/express": "^4.17.13",
    "@types/marked": "^4.0.3",
    "@types/node": "^22.10.2",
    "@types/sharp": "^0.29.5",
    "dotenv": "^16.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.18.1",
    "globals": "^16.5.0",
    "marked": "^4.0.18",
    "mdsvex": "^0.12.7",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^4.1.0",
    "prisma": "^7.8.0",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-external-links": "^1.0.1",
    "rehype-slug": "^5.0.1",
    "sharp": "^0.29.3",
    "svelte": "^5.56.2",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "ts-node": "^10.4.0",
    "tslib": "^2.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.4",
    "wrangler": "^4.108.0",
    "yaml": "^2.1.1"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@auth/sveltekit": "^1.11.2",
    "@citation-js/core": "^0.6.1",
    "@citation-js/plugin-csl": "^0.6.4",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "eslint-plugin-svelte": "^3.13.1",
    "libsodium-wrappers": "^0.8.4",
    "pagedjs": "^0.4.3"
  }
}
